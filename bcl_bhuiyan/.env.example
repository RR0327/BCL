# Copy to .env (never commit .env). Generate a random secret with Django get_random_secret_key.
DJANGO_SECRET_KEY=replace-with-a-unique-random-string-of-at-least-32-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# Production: DB_ENGINE=postgresql and provide values via environment secrets
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ielts
# DB_USER=ielts_app
# DB_PASSWORD=secret-from-secret-manager
# DB_SSLMODE=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=True
# TRUST_PROXY_SSL_HEADER=False
# DJANGO_HSTS_SECONDS=0
